# Copy to .env and fill in what you need. Empty values use the defaults.
#   docker run --rm -p 3000:3000 --env-file .env workspace-integration-service

# Language model for the assistant chat (any OpenAI-compatible endpoint).
# Default: http://127.0.0.1:11434/v1 (Ollama). In Docker, use http://host.docker.internal:11434/v1.
LLM_BASE_URL=
# Default: qwen2.5:3b
LLM_MODEL=
LLM_API_KEY=

# Token signing key. Default: a public development value; set your own outside local testing.
JWT_SECRET=

# Default: 3000
PORT=
