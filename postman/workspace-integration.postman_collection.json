        {
          "name": "Re-size is forbidden",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/projects/{{projectId}}/items/{{drv03}}/resize",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "projects",
                "{{projectId}}",
                "items",
                "{{drv03}}",
                "resize"
              ]
            },
            "description": "Expect 403: channel partners cannot change items.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"motorKw\": 110\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Chat: the same cost question",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/projects/{{projectId}}/assistant/messages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "projects",
                "{{projectId}}",
                "assistant",
                "messages"
              ]
            },
            "description": "The assistant cannot see prices for this role, so it says they are not available. Needs Ollama.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"What will this layout cost, and which item has the longest lead time?\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Signs a local dev token for this folder's role, the same way `npm run token` does.",
              "const CryptoJS = require('crypto-js');",
              "const b64url = (words) => CryptoJS.enc.Base64.stringify(words).replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
              "const part = (obj) => b64url(CryptoJS.enc.Utf8.parse(JSON.stringify(obj)));",
              "const now = Math.floor(Date.now() / 1000);",
              "const payload = {",
              "  sub: 'user-channel_partner',",
              "  role: 'channel_partner',",
              "  country: pm.collectionVariables.get('country'),",
              "  iss: pm.collectionVariables.get('issuer'),",
              "  aud: pm.collectionVariables.get('audience'),",
              "  iat: now,",
              "  exp: now + 3600,",
              "};",
              "const unsigned = part({ alg: 'HS256', typ: 'JWT' }) + '.' + part(payload);",
              "const signature = b64url(CryptoJS.HmacSHA256(unsigned, pm.collectionVariables.get('jwtSecret')));",
              "pm.variables.set('token', unsigned + '.' + signature);"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Re-size",
      "description": "Changes DRV-03 for a 110 kW motor: R7 becomes R8. Restart `npm start` to reset.",
      "item": [
        {
          "name": "Re-size DRV-03 to 110 kW",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "postman-resize-1"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/projects/{{projectId}}/items/{{drv03}}/resize",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "projects",
                "{{projectId}}",
                "items",
                "{{drv03}}",
                "resize"
              ]
            },
            "description": "Returns the new variant, 3D model and BOM change. Sending it again with the same Idempotency-Key returns the same answer.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"motorKw\": 110\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Re-size with an old revision (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/projects/{{projectId}}/items/{{drv03}}/resize",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "projects",
                "{{projectId}}",
                "items",
                "{{drv03}}",
                "resize"
              ]
            },
            "description": "Expect 409: the item is no longer at revision 1.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"motorKw\": 150,\n  \"baseRevision\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Invalid body (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/projects/{{projectId}}/items/{{drv03}}/resize",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "projects",
                "{{projectId}}",
                "items",
                "{{drv03}}",
                "resize"
              ]
            },
            "description": "Expect 400: motorKw must be positive.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"motorKw\": -5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Signs a local dev token for this folder's role, the same way `npm run token` does.",
              "const CryptoJS = require('crypto-js');",
              "const b64url = (words) => CryptoJS.enc.Base64.stringify(words).replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
              "const part = (obj) => b64url(CryptoJS.enc.Utf8.parse(JSON.stringify(obj)));",
              "const now = Math.floor(Date.now() / 1000);",
              "const payload = {",
              "  sub: 'user-sales_engineer',",
              "  role: 'sales_engineer',",
              "  country: pm.collectionVariables.get('country'),",
              "  iss: pm.collectionVariables.get('issuer'),",
              "  aud: pm.collectionVariables.get('audience'),",
              "  iat: now,",
              "  exp: now + 3600,",
              "};",
              "const unsigned = part({ alg: 'HS256', typ: 'JWT' }) + '.' + part(payload);",
              "const signature = b64url(CryptoJS.HmacSHA256(unsigned, pm.collectionVariables.get('jwtSecret')));",
              "pm.variables.set('token', unsigned + '.' + signature);"
