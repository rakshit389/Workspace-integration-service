              }
            ],
            "url": {
              "raw": "{{baseUrl}}/mcp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "mcp"
              ]
            },
            "description": "Find cabinets.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"search_catalogue\",\n    \"arguments\": {\n      \"text\": \"cabinet\"\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "5. resize_item (proposal only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json, text/event-stream"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/mcp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "mcp"
              ]
            },
            "description": "Proposes re-sizing DRV-04 to 80 kW. The item does not change yet.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"resize_item\",\n    \"arguments\": {\n      \"projectId\": \"{{projectId}}\",\n      \"item\": \"DRV-04\",\n      \"motorKw\": 80\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Saves the proposal ID so '5. Confirm the proposal' can use it.",
                  "const result = JSON.parse(pm.response.json().result.content[0].text);",
                  "if (result.proposalId) pm.collectionVariables.set('proposalId', result.proposalId);",
                  "pm.test('a proposal was created, nothing changed yet', () => pm.expect(result.status).to.eql('confirmation_required'));"
                ]
              }
            }
          ]
        },
        {
          "name": "6. Confirm the proposal",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/projects/{{projectId}}/assistant/proposals/{{proposalId}}/confirm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "projects",
                "{{projectId}}",
                "assistant",
                "proposals",
                "{{proposalId}}",
                "confirm"
              ]
            },
            "description": "The user's browser confirms; now DRV-04 changes. Sending it a second time returns 404."
          }
        },
        {
          "name": "7. resize_item again (to cancel)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json, text/event-stream"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/mcp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "mcp"
              ]
            },
            "description": "A new proposal, this time to reject.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"resize_item\",\n    \"arguments\": {\n      \"projectId\": \"{{projectId}}\",\n      \"item\": \"DRV-04\",\n      \"motorKw\": 120\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Saves the proposal ID so '5. Confirm the proposal' can use it.",
                  "const result = JSON.parse(pm.response.json().result.content[0].text);",
                  "if (result.proposalId) pm.collectionVariables.set('proposalId', result.proposalId);",
                  "pm.test('a proposal was created, nothing changed yet', () => pm.expect(result.status).to.eql('confirmation_required'));"
                ]
              }
            }
          ]
        },
        {
          "name": "8. Cancel the proposal",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/projects/{{projectId}}/assistant/proposals/{{proposalId}}/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "projects",
                "{{projectId}}",
                "assistant",
                "proposals",
                "{{proposalId}}",
                "cancel"
              ]
            },
            "description": "The user rejects the proposal; nothing changes."
          }
        },
        {
          "name": "9. Chat: ask the assistant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/projects/{{projectId}}/assistant/messages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "projects",
                "{{projectId}}",
                "assistant",
                "messages"
              ]
            },
            "description": "Needs a language model: Ollama running with qwen2.5:3b (see README). Without one this returns 503.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"What will this layout cost, and which item has the longest lead time?\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Signs a local dev token for this folder's role, the same way `npm run token` does.",
              "const CryptoJS = require('crypto-js');",
              "const b64url = (words) => CryptoJS.enc.Base64.stringify(words).replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
              "const part = (obj) => b64url(CryptoJS.enc.Utf8.parse(JSON.stringify(obj)));",
