{
  "info": {
    "name": "Workspace integration service",
    "description": "Every endpoint of the workspace integration service.\n\n1. Start the service: `npm start` in the project folder.\n2. Run the requests top to bottom. Each folder signs its own login token for its role, so nothing has to be copied.\n\nRe-sizing changes DRV-03. To start again from the original data, restart `npm start`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "projectId",
      "value": "P-24117"
    },
    {
      "key": "otherProjectId",
      "value": "P-30002"
    },
    {
      "key": "drv03",
      "value": "3f6c1d2e-0a41-4b8e-9d1e-2b7c1f0a9e03"
    },
    {
      "key": "otherDrive",
      "value": "a7c2e9f4-3b1d-4e8a-9f6c-0d2b5e8a1c07"
    },
    {
      "key": "country",
      "value": "DE"
    },
    {
      "key": "jwtSecret",
      "value": "local-dev-secret-change-me-0123456789abcdef"
    },
    {
      "key": "issuer",
      "value": "https://idp.mock.local"
    },
    {
      "key": "audience",
      "value": "workspace-api"
    },
    {
      "key": "proposalId",
      "value": ""
    },
    {
      "key": "ticket",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Sales engineer",
      "description": "Sees everything, including prices. Run 'Sidebar' twice: sizing is usually 'pending' the first time and 'ok' the second.",
      "item": [
        {
          "name": "Health (no login)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Is the service running?",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Project items",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/projects/{{projectId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "projects",
                "{{projectId}}"
              ]
            },
            "description": "Items in the project with their IDs."
          }
        },
        {
          "name": "Sidebar for DRV-03",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/projects/{{projectId}}/items/{{drv03}}/sidebar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "projects",
                "{{projectId}}",
                "items",
                "{{drv03}}",
                "sidebar"
              ]
            },
            "description": "All panels for DRV-03 within the time budget. Each panel has its own status."
          }
        },
        {
          "name": "One panel: sizing",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/projects/{{projectId}}/items/{{drv03}}/panels/sizing",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "projects",
                "{{projectId}}",
                "items",
                "{{drv03}}",
                "panels",
                "sizing"
              ]
            },
            "description": "Reloads only the sizing panel, e.g. after it was 'pending'."
          }
        },
        {
          "name": "BOM with prices",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/projects/{{projectId}}/bom",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "projects",
                "{{projectId}}",
                "bom"
              ]
            },
            "description": "Parts list with prices, total and longest lead time."
          }
        },
        {
          "name": "Catalogue search",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/catalogue/search?kind=drive&minKw=90&ipRating=IP54",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "catalogue",
                "search"
              ],
              "query": [
                {
                  "key": "kind",
                  "value": "drive"
                },
                {
                  "key": "minKw",
                  "value": "90"
                },
                {
                  "key": "ipRating",
                  "value": "IP54"
                }
              ]
            },
            "description": "Drives of at least 90 kW with IP54."
          }
        }
      ],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Signs a local dev token for this folder's role, the same way `npm run token` does.",
              "const CryptoJS = require('crypto-js');",
              "const b64url = (words) => CryptoJS.enc.Base64.stringify(words).replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
              "const part = (obj) => b64url(CryptoJS.enc.Utf8.parse(JSON.stringify(obj)));",
              "const now = Math.floor(Date.now() / 1000);",
              "const payload = {",
              "  sub: 'user-sales_engineer',",
              "  role: 'sales_engineer',",
              "  country: pm.collectionVariables.get('country'),",
              "  iss: pm.collectionVariables.get('issuer'),",
              "  aud: pm.collectionVariables.get('audience'),",
              "  iat: now,",
              "  exp: now + 3600,",
              "};",
              "const unsigned = part({ alg: 'HS256', typ: 'JWT' }) + '.' + part(payload);",
              "const signature = b64url(CryptoJS.HmacSHA256(unsigned, pm.collectionVariables.get('jwtSecret')));",
              "pm.variables.set('token', unsigned + '.' + signature);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Channel partner",
      "description": "Same project, but prices and lead times are never shown and the pricing system is not called.",
      "item": [
        {
          "name": "Sidebar: pricing not permitted",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/projects/{{projectId}}/items/{{drv03}}/sidebar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "projects",
                "{{projectId}}",
                "items",
                "{{drv03}}",
                "sidebar"
              ]
            },
            "description": "The pricing panel is 'not_permitted'."
          }
        },
        {
          "name": "BOM without prices",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/projects/{{projectId}}/bom",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "projects",
                "{{projectId}}",
                "bom"
